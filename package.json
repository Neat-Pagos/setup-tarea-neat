{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon --exec tsx src/index.ts",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "start": "node dist/index.js",
    "seed:pokemon": "tsx src/seeds/pokemon-seed.ts",
    "seed:adoptions": "tsx src/seeds/adoptions-seed.ts",
    "seed": "npm run seed:pokemon && npm run seed:adoptions",
    "clear": "tsx src/scripts/clear-database.ts",
    "fix-seed": "tsx src/scripts/fix-seed.ts",
    "register:user": "tsx src/scripts/register-user.ts",
    "install:frontend": "cd frontend && npm install",
    "check:design": "impeccable detect frontend/src"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "concurrently": "^8.2.2",
    "impeccable": "^3.6.0",
    "nodemon": "^3.0.1",
    "tsx": "^4.0.0",
    "typescript": "^5.2.2"
  }
}
